# Server ENV has priority. Do not commit a real .env or encryption key.
# Generate separate secrets locally, then uncomment and fill:
# CHEFAS_PROXY_ADMIN_TOKEN=
# CHEFAS_PROXY_SECRETS_KEY=
# Optional ENV-only pool passwords (alternative to encrypted config):
CHEFAS_PROXY_USER_PASSWORD=x
CHEFAS_PROXY_DEVFEE_PASSWORD=x
