# Manual developer configuration; the operator package generates its own .env.
# Never copy this example over existing credentials. Server ENV has priority.
# Generate separate secrets locally for source runs, then uncomment and fill:
# CHEFAS_PROXY_ADMIN_TOKEN=
# CHEFAS_PROXY_SECRETS_KEY=
# Optional source-runtime pool passwords (alternative to encrypted config):
CHEFAS_PROXY_USER_PASSWORD=x
CHEFAS_PROXY_DEVFEE_PASSWORD=x
