[Unit]
Description=CHEFAS Proxy Stratum mining proxy
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=chefas-proxy
Group=chefas-proxy
WorkingDirectory="/etc/chefas-proxy"
EnvironmentFile="/etc/chefas-proxy/chefas-proxy.env"
ExecStart="/opt/chefas-proxy/chefas-proxy" --config "/etc/chefas-proxy/chefas-proxy.json" --env-file= --control-state=/var/lib/chefas-proxy/control.json --history-file=/var/lib/chefas-proxy/history.json --compatibility-state=/var/lib/chefas-proxy/compatibility.json --devfee-journal=/var/lib/chefas-proxy/devfee.sqlite3 --log-dir=/var/log/chefas-proxy
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=45
LimitNOFILE=65535
UMask=0077
StateDirectory=chefas-proxy
LogsDirectory=chefas-proxy
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
